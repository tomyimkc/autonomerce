FROM node:22.17.0-bookworm-slim@sha256:b04ce4ae4e95b522112c2e5c52f781471a5cbc3b594527bcddedee9bc48c03a0 AS base

ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS dependencies

WORKDIR /build/apps/web

COPY apps/web/package.json apps/web/package-lock.json ./

RUN npm ci --no-audit --no-fund

FROM base AS builder

WORKDIR /build/apps/web

COPY --from=dependencies /build/apps/web/node_modules ./node_modules
COPY apps/web ./

# No deployment credentials or NEXT_PUBLIC_* configuration is accepted as a
# build argument. LIVE credentials are injected into the final Cloud Run
# revision as server-only Secret Manager environment variables.
RUN npm run build

FROM base AS runtime

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=8080

WORKDIR /app

COPY --chown=node:node --from=builder /build/apps/web/.next/standalone ./
COPY --chown=node:node --from=builder /build/apps/web/.next/static ./.next/static

USER node

EXPOSE 8080

CMD ["node", "server.js"]
