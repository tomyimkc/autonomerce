# Safe local defaults only. Never commit real keys, wallet sessions, recovery
# material, bearer tokens, or service-account credentials.
AUTONOMERCE_DEPLOYMENT_MODE=local-offline
AUTONOMERCE_MODE=offline
AUTONOMERCE_API_AUTH_MODE=local-only
AUTONOMERCE_API_OWNER_ID=autonomerce-owner
AUTONOMERCE_API_WORKERS=1
# Secret: leave blank in source; inject only from an approved secret store.
AUTONOMERCE_API_BEARER_TOKEN=
AUTONOMERCE_WEB_PUBLIC_ORIGIN=http://localhost:3000
AUTONOMERCE_API_PRIVATE_ORIGIN=http://127.0.0.1:8000
AUTONOMERCE_TRUSTED_HOSTS=127.0.0.1,localhost
# Keep false unless a trusted edge strips/overwrites client forwarding headers.
AUTONOMERCE_WEB_TRUST_PROXY_HEADERS=false
AUTONOMERCE_SELLER_AGENT_CARD_URL=

# Google Vertex AI through Application Default Credentials or the Cloud Run
# runtime service account. Do not mount a service-account key file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
AUTONOMERCE_GEMINI_MODEL=

# Canonical payment-adapter configuration. AUTONOMERCE_MODE selects the composed
# runtime; these AUTONOMERCE_PAYMENT_* names configure the payment adapter itself.
AUTONOMERCE_PAYMENT_MODE=offline
AUTONOMERCE_PAYMENT_MAX_PER_PAYMENT_USDC=1
AUTONOMERCE_PAYMENT_MAX_TOTAL_USDC=10
AUTONOMERCE_PAYMENT_MAX_COUNT=10
AUTONOMERCE_PAYMENT_ALLOWED_CHAINS=ARC-TESTNET
AUTONOMERCE_PAYMENT_ALLOWED_PAYER_WALLETS=
AUTONOMERCE_PAYMENT_ALLOWED_PAYEE_WALLETS=
AUTONOMERCE_PAYMENT_SQLITE_PATH=
AUTONOMERCE_COMMERCE_SQLITE_PATH=
AUTONOMERCE_CIRCLE_CLI_BINARY=/usr/local/bin/circle
AUTONOMERCE_CIRCLE_CLI_SHA256=
AUTONOMERCE_TRANSACTION_LOOKUP_FACTORY=
AUTONOMERCE_RECEIPT_PUBLICATION_MODE=disabled
AUTONOMERCE_PUBLICATION_CONSENT_VERIFIER_FACTORY=
AUTONOMERCE_ENABLE_MAINNET_PAYMENTS=
AUTONOMERCE_SELLER_EXECUTOR_FACTORY=

# Infra preflight metadata. Offline mode must use memory-offline. A non-offline
# single-host deployment must use single-host-persistent-volume, set an absolute
# mount path, and provision the marker described in docs/DEPLOYMENT-SECURITY.md.
# Cloud Run live-payment modes are intentionally blocked until the application has
# a shared managed durable-store adapter.
AUTONOMERCE_PAYMENT_STORE_DURABILITY=memory-offline
AUTONOMERCE_PAYMENT_DURABLE_MOUNT_PATH=
